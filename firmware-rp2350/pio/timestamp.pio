; =============================================================================
; timestamp.pio — captura de borda com timestamp para o medidor de latência.
;
; Três SMs rodam este programa (uma por entrada: T0, T1_CLICK, T1_MOTION).
; Cada SM mantém um contador X de 32 bits que anda para BAIXO (down counter) e
; funciona como relógio local. O ponto-chave para medir T1-T0 com precisão:
;
;   TIMEBASE LOCKSTEP
;   - Todas as SMs recebem a MESMA base C via `pull` (TX FIFO escrita pela CPU).
;   - O `pull block` no início (start:) e depois de cada hit (hit:) garante que
;     as três SMs reiniciem X = C ao mesmo instante de clock.
;   - O loop de contagem usa EXATAMENTE 2 ciclos por iteração para todos os SMs
;     (mesma estrutura em rising/falling), então os contadores só divergem por
;     efeitos comuns (wrap simultâneo), que não afetam a DIFERENÇA entre
;     timestamps no mesmo pass.
;   - A CPU só grava uma nova base C' depois que os SMs do par ativo (T0 e o T1
;     da eixo em teste) já terminaram o pass anterior (estão travados em pull).
;
;   RESOLUÇÃO = 2 ciclos PIO (~13 ns a 150 MHz; ~8 ns a 250 MHz).
;   PULSO MÍNIMO DETECTÁVEL ~= 2 ciclos (~26 ns a 150 MHz). Um pulso de
;   motion de ~10 ns pode exigir overclock do system clock — VALIDAR NO
;   OSCILOSCÓPIO e ajustar SYSTEM_CLOCK_KHZ em config.h.
;
;   ARMAÇÃO: os pinos devem estar em nível de repouso no momento do arme
;   (LOW para rising, HIGH para falling). Se o pino já estiver no nível-alvo
;   ao armar, o SM entra em spin (não conta) até o nível voltar — isso
;   dessincroniza a base e é evitado pelo firmware (só arma com repouso).
;
;   IMPORTANTE: o pioasm deste SDK não expõe `jmp !pin`. A detecção de queda
;   usa apenas `jmp pin` com fall-through: no loop, "pino HIGH -> decrementa";
;   "pino LOW -> cai no hit". Em rising, "pino HIGH -> hit; pino LOW -> cai no
;   decrementa". Ambos os loops têm 2 ciclos por iteração e topologia idêntica,
;   o que preserva o lockstep entre as SMs dos dois programas.
;
;   PROTOCOLO DE SAÍDA: a cada borda detectada, faz push de 32 bits com o valor
;   de X no instante da amostra que viu o nível-alvo.
; =============================================================================

.program timestamp_rising
; Detecta borda SUBIDA no pino de entrada. Repouso = LOW.

start:
    pull block        ; 1c: aguarda base inicial/novo pass (CPU grava C)
    mov x, osr        ; 1c: X = C

main:
    jmp pin spin_hi   ; 1c: se pino já alto no arme -> espera voltar a baixo
count:                ; loop de 2 ciclos
    jmp pin hit       ; 1c: HIGH -> borda (hit); LOW -> continue
dec:
    jmp x-- count     ; 1c: decrementa X e repete (X==0 -> cai em wrap)
wrap:
    set x, 31         ; 1c (X==0; comum a todos os SMs)
    jmp count         ; 1c

spin_hi:
    jmp pin spin_hi   ; 1c: spin sem contar (arme inválido; pino alto)
    jmp count        ; 1c: pino voltou a LOW -> entra na contagem

hit:
    mov isr, x        ; 1c: timestamp
    push              ; 1c: envia ao RX FIFO (DMA drena)
    pull block        ; aguarda novo arme
    mov x, osr        ; nova base (sincronização implícita com os demais SMs)
    jmp main          ; reavalia repouso antes de contar de novo

.program timestamp_falling
; Detecta borda DESCIDA (T0 em modo pull-up). Repouso = HIGH.
; Usa SOMENTE `jmp pin`: pino HIGH -> decrementa; pino LOW -> cai em hit.

start:
    pull block
    mov x, osr

main:
    jmp pin count     ; 1c: pino HIGH -> conta direto
spin_lo:
    jmp pin count     ; 1c: LOW no arme: espera subir (arme inválido)
    jmp spin_lo       ; 1c

count:                ; loop de 2 ciclos; conta enquanto HIGH
    jmp pin dec       ; 1c: HIGH -> decrementa; LOW (borda) -> cai em hit
hit:
    mov isr, x        ; 1c: timestamp
    push
    pull block
    mov x, osr
    jmp main
dec:
    jmp x-- count     ; 1c (X==0 -> cai em wrap)
wrap:
    set x, 31
    jmp count